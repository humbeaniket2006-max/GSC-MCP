# Placeholders only. Never commit real values.
# Auth: service account key file path (see README for the local OAuth --login alternative).
GSC_CREDENTIALS_PATH=/path/to/service-account-key-file
PSI_API_KEY=your-pagespeed-api-key
# Optional: comma-separated property allowlist
GSC_ALLOWED_SITES=sc-domain:example.com,https://www.example.com/
# Optional: set to 1 to enable submit_sitemap / delete_sitemap (needs the write scope)
GSC_ENABLE_WRITE=0
# Daily caps (UTC) and per-minute limit; defaults shown
GSC_DAILY_CAP_TOTAL=1500
GSC_DAILY_CAP_ANALYTICS=1000
GSC_DAILY_CAP_INSPECT=1500
GSC_DAILY_CAP_PSI=200
GSC_DAILY_CAP_FETCH=200
GSC_DAILY_CAP_WRITE=20
GSC_RATE_PER_MIN=60
# Remote (--http) mode only: fallback password and static bearer token (24+ chars);
# HOST/PORT bind (default 127.0.0.1:8000)
MCP_AUTH_TOKEN=generate-a-long-random-string-here
HOST=127.0.0.1
PORT=8000
# Preferred sign-in for Claude ("Use your own OAuth client"): paste both values into the
# connector form and it connects with no prompt. Secret must be 24+ characters.
# Optional OAUTH_REDIRECT_URIS (comma-separated) overrides the claude.ai/claude.com callbacks.
OAUTH_CLIENT_ID=gsc-mcp-claude
OAUTH_CLIENT_SECRET=generate-a-long-random-string-here
