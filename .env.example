# Placeholders only. Never commit real values.
# Auth: pick one. Service account key file path, or OAuth client file (+ `python server.py --login`).
GSC_CREDENTIALS_PATH=/path/to/service-account-key-file
GSC_OAUTH_CLIENT_SECRETS=/path/to/oauth-desktop-client-file
PSI_API_KEY=your-pagespeed-api-key
# Optional: comma-separated property allowlist
GSC_ALLOWED_SITES=sc-domain:example.com,https://www.example.com/
# Optional: set to 1 to enable submit_sitemap / delete_sitemap (needs the write scope)
GSC_ENABLE_WRITE=0
# Daily caps (UTC) and per-minute limit; defaults shown
GSC_DAILY_CAP_TOTAL=1500
GSC_DAILY_CAP_ANALYTICS=1000
GSC_DAILY_CAP_INSPECT=1500
GSC_DAILY_CAP_PSI=200
GSC_DAILY_CAP_FETCH=200
GSC_DAILY_CAP_WRITE=20
GSC_RATE_PER_MIN=60
# Remote (--http) mode only: bearer token clients must send; HOST/PORT bind (default 127.0.0.1:8000)
MCP_AUTH_TOKEN=generate-a-long-random-string-here
HOST=127.0.0.1
PORT=8000
